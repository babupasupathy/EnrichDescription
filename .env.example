# Copy to .env for local development. NEVER commit .env.
# In production, set these as Streamlit secrets (app) and Cloud Run secrets (MCP servers).

# --- App (Streamlit) ----------------------------------------------------------------------
OPENROUTER_API_KEY=
# Model tiers (exact OpenRouter slugs)
MODEL_CHEAP=qwen/qwen3.6-35b-a3b
MODEL_MID=minimax/minimax-m3
MODEL_TOP=deepseek/deepseek-v4.1-flash
# Optional: comma-separated OpenRouter provider names to pin (e.g. US-hosted providers)
OPENROUTER_PROVIDER_ORDER=

# Marketplace MCP servers (local default shown; use your Cloud Run URL in production)
MCP_EBAY_URL=http://localhost:8080/ebay/mcp
MCP_AMAZON_URL=http://localhost:8080/amazon/mcp
# Shared secret between the app and the MCP servers. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# LangSmith tracing, evals and star-rating feedback
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enrich-description

# --- MCP servers (Cloud Run) ----------------------------------------------------------------
# MCP_AUTH_TOKEN above is needed here too.
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
RAINFOREST_API_KEY=
